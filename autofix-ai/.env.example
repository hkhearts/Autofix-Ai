# ==============================================================
# Autofix-AI Environment Configuration
# ==============================================================

# Groq API Configuration (for multimodal Vision OCR & Error Signature normalization)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# Vectorize Hindsight Configuration (Agent Memory Layer)
# Use promo code 'MEMHACK99' on Vectorize.io for free API credits
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=autofix_ai_tickets

# Decision Gate Threshold (>= 0.85 triggers autonomous resolution)
CONFIDENCE_THRESHOLD=0.85

# Server & Network Configuration
PORT=8000
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://autofix-ai-frontend-3shv.onrender.com,https://autofix-ai-backend-51vk.onrender.com,*

# Default Authentication Testing Credentials
DEFAULT_COMPANY_ID=acme-corp
DEFAULT_ADMIN_EMAIL=admin@autofix.ai
DEFAULT_ADMIN_PASSWORD=password123
